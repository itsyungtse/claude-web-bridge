{
  "manifest_version": 3,
  "name": "Claude Web Bridge",
  "version": "0.1.0",
  "description": "Pick an element or drag a region and chat with your local Claude Code sessions.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:4567/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Claude Web Bridge" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" }
    },
    "start-picker": {
      "suggested_key": { "default": "Alt+Shift+E", "mac": "Alt+Shift+E" },
      "description": "Pick an element without closing open popups"
    },
    "start-region": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Drag a region without closing open popups"
    }
  }
}
